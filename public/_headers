# Security headers — Netlify / Cloudflare Pages convention (both read this
# file automatically). If a different host is chosen later, configure the
# equivalent there instead (e.g. vercel.json "headers", nginx add_header).
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
